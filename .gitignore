# Raw and processed data are far too large to ship (4.6 GB and ~860 MB). The deployable
# subset is data/demo, which is committed deliberately.
data/raw/
data/cache/
data/processed/
!data/demo/
!data/demo/**

# Feature matrices are regenerated by training/prepare_dataset.py.
*.npz

# Only the shipped XGBoost artifact is committed; the comparison artifacts are large
# (the random forest alone is 92 MB) and are rebuilt by scripts/compare_models.py.
models/artifacts/*
!models/artifacts/activity_predictor.joblib

# Secrets: the Hugging Face token must never be committed.
.env
.streamlit/secrets.toml

__pycache__/
*.pyc
.pytest_cache/
